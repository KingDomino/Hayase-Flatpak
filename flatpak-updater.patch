+import { spawn } from 'node:child_process'
+import { EventEmitter } from 'node:events'
+import { existsSync } from 'node:fs'
+import { createConnection, type Socket } from 'node:net'
+import { env, getuid } from 'node:process'
+
+import { app } from 'electron'
+import log from 'electron-log/main'
+
+const DBUS_DEST = 'org.freedesktop.DBus'
+const DBUS_PATH = '/org/freedesktop/DBus'
+const DBUS_IFACE = 'org.freedesktop.DBus'
+
+const PORTAL_DEST = 'org.freedesktop.portal.Flatpak'
+const PORTAL_PATH = '/org/freedesktop/portal/Flatpak'
+const PORTAL_IFACE = 'org.freedesktop.portal.Flatpak'
+const MONITOR_IFACE = 'org.freedesktop.portal.Flatpak.UpdateMonitor'
+
+const MSG_METHOD_CALL = 1
+const MSG_METHOD_RETURN = 2
+const MSG_ERROR = 3
+const MSG_SIGNAL = 4
+
+const FIELD_PATH = 1
+const FIELD_INTERFACE = 2
+const FIELD_MEMBER = 3
+const FIELD_ERROR_NAME = 4
+const FIELD_REPLY_SERIAL = 5
+const FIELD_DESTINATION = 6
+const FIELD_SIGNATURE = 8
+
+const STATUS_RUNNING = 0
+const STATUS_EMPTY = 1
+const STATUS_DONE = 2
+const STATUS_FAILED = 3
+
+interface DbusSignal {
+  path?: string
+  iface?: string
+  member?: string
+  body: Buffer
+  le: boolean
+}
+
+interface PendingCall {
+  resolve: (body: Buffer, le: boolean) => void
+  reject: (err: Error) => void
+}
+
+function alignUp (n: number, align: number): number {
+  const rem = n % align
+  return rem === 0 ? n : n + (align - rem)
+}
+
+function padBuffer (buf: Buffer, align: number): Buffer {
+  const target = alignUp(buf.length, align)
+  return target === buf.length ? buf : Buffer.concat([buf, Buffer.alloc(target - buf.length)])
+}
+
+function encodeString (str: string): Buffer {
+  const bytes = Buffer.from(str, 'utf8')
+  const out = Buffer.alloc(4 + bytes.length + 1)
+  out.writeUInt32LE(bytes.length, 0)
+  bytes.copy(out, 4)
+  return out
+}
+
+function encodeSignature (sig: string): Buffer {
+  const bytes = Buffer.from(sig, 'ascii')
+  const out = Buffer.alloc(1 + bytes.length + 1)
+  out.writeUInt8(bytes.length, 0)
+  bytes.copy(out, 1)
+  return out
+}
+
+function encodeHeaderField (code: number, sig: string, value: Buffer): Buffer {
+  const prefix = Buffer.concat([Buffer.from([code]), encodeSignature(sig)])
+  const align = sig === 's' || sig === 'o' || sig === 'u' ? 4 : 1
+  return Buffer.concat([padBuffer(prefix, align), value])
+}
+
+function encodeMethodCall (
+  serial: number,
+  path: string,
+  iface: string,
+  member: string,
+  dest: string,
+  sig = '',
+  body: Buffer = Buffer.alloc(0)
+): Buffer {
+  const rawFields: Array<[number, string, Buffer]> = [
+    [FIELD_PATH, 'o', encodeString(path)],
+    [FIELD_INTERFACE, 's', encodeString(iface)],
+    [FIELD_MEMBER, 's', encodeString(member)],
+    [FIELD_DESTINATION, 's', encodeString(dest)]
+  ]
+  if (sig) rawFields.push([FIELD_SIGNATURE, 'g', encodeSignature(sig)])
+
+  let fields: Buffer = Buffer.alloc(0)
+  for (const [code, fsig, val] of rawFields) {
+    fields = Buffer.concat([padBuffer(fields, 8), encodeHeaderField(code, fsig, val)])
+  }
+
+  const fixed = Buffer.alloc(16)
+  fixed.writeUInt8(0x6c, 0) // 'l' little-endian
+  fixed.writeUInt8(MSG_METHOD_CALL, 1)
+  fixed.writeUInt8(0, 2)
+  fixed.writeUInt8(1, 3)
+  fixed.writeUInt32LE(body.length, 4)
+  fixed.writeUInt32LE(serial, 8)
+  fixed.writeUInt32LE(fields.length, 12)
+
+  return Buffer.concat([padBuffer(Buffer.concat([fixed, fields]), 8), body])
+}
+
+class DbusReader {
+  buf: Buffer
+  le: boolean
+  offset = 0
+
+  constructor (buf: Buffer, le: boolean) {
+    this.buf = buf
+    this.le = le
+  }
+
+  align (a: number) {
+    this.offset = alignUp(this.offset, a)
+  }
+
+  u8 (): number {
+    const v = this.buf.readUInt8(this.offset)
+    this.offset += 1
+    return v
+  }
+
+  u16 (): number {
+    this.align(2)
+    const v = this.le ? this.buf.readUInt16LE(this.offset) : this.buf.readUInt16BE(this.offset)
+    this.offset += 2
+    return v
+  }
+
+  i16 (): number {
+    this.align(2)
+    const v = this.le ? this.buf.readInt16LE(this.offset) : this.buf.readInt16BE(this.offset)
+    this.offset += 2
+    return v
+  }
+
+  u32 (): number {
+    this.align(4)
+    const v = this.le ? this.buf.readUInt32LE(this.offset) : this.buf.readUInt32BE(this.offset)
+    this.offset += 4
+    return v
+  }
+
+  i32 (): number {
+    this.align(4)
+    const v = this.le ? this.buf.readInt32LE(this.offset) : this.buf.readInt32BE(this.offset)
+    this.offset += 4
+    return v
+  }
+
+  str (): string {
+    const len = this.u32()
+    const s = this.buf.toString('utf8', this.offset, this.offset + len)
+    this.offset += len + 1
+    return s
+  }
+
+  sig (): string {
+    const len = this.u8()
+    const s = this.buf.toString('ascii', this.offset, this.offset + len)
+    this.offset += len + 1
+    return s
+  }
+
+  variant (): unknown {
+    const s = this.sig()
+    switch (s) {
+      case 's':
+      case 'o':
+        return this.str()
+      case 'g':
+        return this.sig()
+      case 'u':
+        return this.u32()
+      case 'i':
+        return this.i32()
+      case 'b':
+        return this.u32() !== 0
+      case 'y':
+        return this.u8()
+      case 'q':
+        return this.u16()
+      case 'n':
+        return this.i16()
+      case 't':
+        this.align(8)
+        {
+          const v = this.le ? this.buf.readBigUInt64LE(this.offset) : this.buf.readBigUInt64BE(this.offset)
+          this.offset += 8
+          return v
+        }
+      case 'x':
+        this.align(8)
+        {
+          const v = this.le ? this.buf.readBigInt64LE(this.offset) : this.buf.readBigInt64BE(this.offset)
+          this.offset += 8
+          return v
+        }
+      case 'd':
+        this.align(8)
+        {
+          const v = this.le ? this.buf.readDoubleLE(this.offset) : this.buf.readDoubleBE(this.offset)
+          this.offset += 8
+          return v
+        }
+      default:
+        return undefined
+    }
+  }
+}
+
+function decodeDict (buf: Buffer, le: boolean): Record<string, unknown> {
+  const result: Record<string, unknown> = {}
+  if (buf.length < 4) return result
+  const reader = new DbusReader(buf, le)
+  const arrayLen = reader.u32()
+  reader.align(8)
+  const end = Math.min(buf.length, reader.offset + arrayLen)
+  while (reader.offset < end) {
+    reader.align(8)
+    if (reader.offset >= end) break
+    const key = reader.str()
+    const val = reader.variant()
+    if (val === undefined) break
+    result[key] = val
+  }
+  return result
+}
+
+function parseSessionBusAddress (addr: string): string {
+  for (const part of addr.split(';')) {
+    if (!part.startsWith('unix:')) continue
+    for (const kv of part.slice(5).split(',')) {
+      const [k, v] = kv.split('=')
+      if (!v) continue
+      const decoded = decodeURIComponent(v)
+      if (k === 'path') return decoded
+      if (k === 'abstract') return '\0' + decoded
+    }
+  }
+  throw new Error(`Unsupported DBUS_SESSION_BUS_ADDRESS: ${addr}`)
+}
+
+class DbusSessionClient extends EventEmitter {
+  private socket: Socket
+  private serial = 1
+  private pending = new Map<number, PendingCall>()
+  private buffer: Buffer = Buffer.alloc(0)
+  private authenticated = false
+  private authBuf = ''
+  ready: Promise<void>
+
+  constructor (busAddress: string) {
+    super()
+    const socketPath = parseSessionBusAddress(busAddress)
+    this.socket = createConnection(socketPath)
+    this.socket.unref()
+
+    this.ready = new Promise<void>((resolve, reject) => {
+      const onEarlyError = (err: Error) => reject(err)
+      this.socket.once('error', onEarlyError)
+      this.socket.once('connect', () => {
+        const uid = getuid?.() ?? 1000
+        const uidHex = Buffer.from(String(uid), 'ascii').toString('hex')
+        this.socket.write(`\0AUTH EXTERNAL ${uidHex}\r\n`)
+      })
+
+      const onData = (chunk: Buffer) => {
+        if (!this.authenticated) {
+          this.authBuf += chunk.toString('latin1')
+          const lineEnd = this.authBuf.indexOf('\r\n')
+          if (lineEnd === -1) return
+          const line = this.authBuf.slice(0, lineEnd)
+          const remainder = this.authBuf.slice(lineEnd + 2)
+          if (!line.startsWith('OK ')) {
+            this.socket.destroy()
+            reject(new Error(`D-Bus auth failed: ${line}`))
+            return
+          }
+          this.authenticated = true
+          this.socket.removeListener('error', onEarlyError)
+          this.socket.write('BEGIN\r\n')
+          if (remainder.length > 0) {
+            this.buffer = Buffer.concat([this.buffer, Buffer.from(remainder, 'latin1')])
+            this.drain()
+          }
+          this.call(DBUS_DEST, DBUS_PATH, DBUS_IFACE, 'Hello')
+            .then(() => resolve())
+            .catch(reject)
+          return
+        }
+
+        this.buffer = Buffer.concat([this.buffer, chunk])
+        this.drain()
+      }
+
+      this.socket.on('data', onData)
+    })
+
+    this.socket.on('error', (err) => {
+      this.failPending(err)
+      this.emit('error', err)
+    })
+    this.socket.on('close', () => {
+      this.failPending(new Error('D-Bus connection closed'))
+      this.emit('close')
+    })
+  }
+
+  private failPending (err: Error) {
+    for (const call of this.pending.values()) {
+      call.reject(err)
+    }
+    this.pending.clear()
+  }
+
+  private drain () {
+    while (this.buffer.length >= 16) {
+      const endian = this.buffer.readUInt8(0)
+      const le = endian === 0x6c // 'l'
+      const mtype = this.buffer.readUInt8(1)
+      const bodyLen = le ? this.buffer.readUInt32LE(4) : this.buffer.readUInt32BE(4)
+      const fieldsLen = le ? this.buffer.readUInt32LE(12) : this.buffer.readUInt32BE(12)
+      const headerTotal = alignUp(16 + fieldsLen, 8)
+      const total = headerTotal + bodyLen
+      if (this.buffer.length < total) return
+
+      const fieldsBuf = this.buffer.subarray(16, 16 + fieldsLen)
+      const bodyBuf = Buffer.from(this.buffer.subarray(headerTotal, total))
+      this.buffer = this.buffer.subarray(total)
+
+      this.handleMessage(mtype, le, fieldsBuf, bodyBuf)
+    }
+  }
+
+  private handleMessage (mtype: number, le: boolean, fieldsBuf: Buffer, body: Buffer) {
+    const reader = new DbusReader(fieldsBuf, le)
+    let path: string | undefined
+    let iface: string | undefined
+    let member: string | undefined
+    let errorName: string | undefined
+    let replySerial: number | undefined
+
+    while (reader.offset < fieldsBuf.length) {
+      reader.align(8)
+      if (reader.offset >= fieldsBuf.length) break
+      const code = reader.u8()
+      const val = reader.variant()
+      if (code === FIELD_PATH && typeof val === 'string') path = val
+      else if (code === FIELD_INTERFACE && typeof val === 'string') iface = val
+      else if (code === FIELD_MEMBER && typeof val === 'string') member = val
+      else if (code === FIELD_ERROR_NAME && typeof val === 'string') errorName = val
+      else if (code === FIELD_REPLY_SERIAL && typeof val === 'number') replySerial = val
+    }
+
+    if (mtype === MSG_METHOD_RETURN && replySerial !== undefined) {
+      const call = this.pending.get(replySerial)
+      if (call) {
+        this.pending.delete(replySerial)
+        call.resolve(body, le)
+      }
+    } else if (mtype === MSG_ERROR && replySerial !== undefined) {
+      const call = this.pending.get(replySerial)
+      if (call) {
+        this.pending.delete(replySerial)
+        let detail = ''
+        try {
+          if (body.length >= 4) detail = new DbusReader(body, le).str()
+        } catch {}
+        call.reject(new Error(`${errorName ?? 'D-Bus error'}${detail ? ': ' + detail : ''}`))
+      }
+    } else if (mtype === MSG_SIGNAL) {
+      const sig: DbusSignal = { path, iface, member, body, le }
+      this.emit('signal', sig)
+    }
+  }
+
+  call (
+    dest: string,
+    path: string,
+    iface: string,
+    member: string,
+    sig = '',
+    body: Buffer = Buffer.alloc(0)
+  ): Promise<{ body: Buffer, le: boolean }> {
+    const serial = this.serial++
+    const frame = encodeMethodCall(serial, path, iface, member, dest, sig, body)
+    return new Promise((resolve, reject) => {
+      this.pending.set(serial, {
+        resolve: (respBody, le) => resolve({ body: respBody, le }),
+        reject
+      })
+      this.socket.write(frame)
+    })
+  }
+
+  close () {
+    this.failPending(new Error('D-Bus client closed'))
+    this.socket.destroy()
+  }
+}
+
+export default class FlatpakUpdater extends EventEmitter {
+  hasUpdate = false
+  private client?: DbusSessionClient
+  private monitorHandle?: string
+  private monitorPromise?: Promise<string>
+  private updating = false
+  private downloadPromise?: Promise<void>
+  private resolveDownload?: () => void
+  private rejectDownload?: (err: Error) => void
+  private runningCommit?: string
+  private localCommit?: string
+  private closed = false
+
+  private async ensureClient (): Promise<DbusSessionClient> {
+    if (this.client) {
+      await this.client.ready
+      return this.client
+    }
+    const addr = env.DBUS_SESSION_BUS_ADDRESS
+    if (!addr) throw new Error('DBUS_SESSION_BUS_ADDRESS is not set')
+
+    const client = new DbusSessionClient(addr)
+    this.client = client
+    client.on('signal', (sig: DbusSignal) => this.onSignal(sig))
+    client.on('error', (err: Error) => log.error('[FlatpakUpdater] D-Bus error:', err))
+    client.on('close', () => {
+      if (this.client === client) {
+        this.client = undefined
+        this.monitorHandle = undefined
+        this.monitorPromise = undefined
+      }
+    })
+
+    try {
+      await client.ready
+      const rule = `type='signal',sender='${PORTAL_DEST}',interface='${MONITOR_IFACE}'`
+      await client.call(DBUS_DEST, DBUS_PATH, DBUS_IFACE, 'AddMatch', 's', encodeString(rule))
+      return client
+    } catch (err) {
+      if (this.client === client) this.client = undefined
+      client.close()
+      throw err
+    }
+  }
+
+  private markUpdateReady () {
+    if (this.hasUpdate) return
+    this.hasUpdate = true
+    this.emit('download-progress', { percent: 100 })
+    this.emit('update-downloaded')
+  }
+
+  private async ensureMonitor (): Promise<string> {
+    if (this.monitorHandle) return this.monitorHandle
+    if (this.monitorPromise) return await this.monitorPromise
+
+    this.monitorPromise = (async () => {
+      const client = await this.ensureClient()
+      // Empty a{sv}: u32(0) + 4-byte pad for 8-byte dict_entry alignment
+      const { body, le } = await client.call(
+        PORTAL_DEST,
+        PORTAL_PATH,
+        PORTAL_IFACE,
+        'CreateUpdateMonitor',
+        'a{sv}',
+        Buffer.alloc(8)
+      )
+      const handle = new DbusReader(body, le).str()
+      this.monitorHandle = handle
+      log.info('[FlatpakUpdater] Monitoring for updates via', handle)
+      return handle
+    })()
+
+    try {
+      return await this.monitorPromise
+    } finally {
+      this.monitorPromise = undefined
+    }
+  }
+
+  private onSignal (sig: DbusSignal) {
+    if (this.closed || sig.iface !== MONITOR_IFACE) return
+    if (sig.path && !this.monitorHandle) this.monitorHandle = sig.path
+
+    if (sig.member === 'UpdateAvailable') {
+      const info = decodeDict(sig.body, sig.le)
+      const running = typeof info['running-commit'] === 'string' ? info['running-commit'] : undefined
+      const local = typeof info['local-commit'] === 'string' ? info['local-commit'] : undefined
+      const remote = typeof info['remote-commit'] === 'string' ? info['remote-commit'] : undefined
+
+      this.runningCommit = running
+      this.localCommit = local
+      log.info('[FlatpakUpdater] Update available:', { running, local, remote })
+
+      if (remote && remote !== local) {
+        this.startUpdate(sig.path ?? this.monitorHandle)
+      } else if (local && running && local !== running) {
+        this.markUpdateReady()
+      }
+    } else if (sig.member === 'Progress') {
+      const info = decodeDict(sig.body, sig.le)
+      const status = typeof info.status === 'number' ? info.status : STATUS_RUNNING
+      const progress = typeof info.progress === 'number' ? info.progress : 0
+      const op = typeof info.op === 'number' ? info.op : 0
+      const nOps = typeof info.n_ops === 'number' ? info.n_ops : 0
+      const error = typeof info.error === 'string' ? info.error : undefined
+      const errorMessage = typeof info.error_message === 'string' ? info.error_message : undefined
+
+      if (status === STATUS_RUNNING) {
+        const percent = nOps > 0
+          ? Math.min(99, Math.max(0, Math.round(((op + progress / 100) / nOps) * 100)))
+          : Math.min(99, Math.max(0, progress))
+        this.emit('download-progress', { percent })
+      } else if (status === STATUS_DONE) {
+        log.info('[FlatpakUpdater] Update installed and ready')
+        this.updating = false
+        this.markUpdateReady()
+        this.resolveDownload?.()
+        this.clearDownloadPromise()
+      } else if (status === STATUS_EMPTY) {
+        this.updating = false
+        if ((this.localCommit && this.runningCommit && this.localCommit !== this.runningCommit) || existsSync('/app/.updated')) {
+          this.markUpdateReady()
+          this.resolveDownload?.()
+        } else {
+          this.rejectDownload?.(new Error('No update available'))
+        }
+        this.clearDownloadPromise()
+      } else if (status === STATUS_FAILED) {
+        const msg = errorMessage || error || 'Flatpak update failed'
+        log.error('[FlatpakUpdater] Update failed:', { error, errorMessage })
+        this.updating = false
+        this.rejectDownload?.(new Error(msg))
+        this.clearDownloadPromise()
+      }
+    }
+  }
+
+  private clearDownloadPromise () {
+    this.downloadPromise = undefined
+    this.resolveDownload = undefined
+    this.rejectDownload = undefined
+  }
+
+  private startUpdate (handle?: string) {
+    if (this.updating || !handle || !this.client) return
+    this.updating = true
+    this.downloadPromise = new Promise<void>((resolve, reject) => {
+      this.resolveDownload = resolve
+      this.rejectDownload = reject
+    })
+    // Avoid unhandledRejection if nobody is awaiting updateReady()
+    this.downloadPromise.catch(() => {})
+
+    // Method Update(s parent_window, a{sv} options): "" + empty a{sv}
+    // Empty string (u32(0) + NUL = 5 bytes) padded to 4 -> 8 bytes,
+    // followed by empty a{sv} (u32(0) + 4-byte pad for 8-byte dict_entry = 8 bytes) -> 16 zero bytes.
+    const body = Buffer.alloc(16)
+    this.client.call(PORTAL_DEST, handle, MONITOR_IFACE, 'Update', 'sa{sv}', body).catch((err: Error) => {
+      log.error('[FlatpakUpdater] Update() call failed:', err)
+      this.updating = false
+      this.rejectDownload?.(err)
+      this.clearDownloadPromise()
+    })
+  }
+
+  async checkForUpdates (): Promise<void> {
+    if (this.closed || this.hasUpdate) return
+    if (existsSync('/app/.updated')) {
+      this.markUpdateReady()
+      return
+    }
+    try {
+      await this.ensureMonitor()
+    } catch (err) {
+      log.error('[FlatpakUpdater] Failed to initialize update monitor:', err)
+    }
+  }
+
+  async waitForUpdateReady (): Promise<void> {
+    if (this.hasUpdate) return
+    if (existsSync('/app/.updated')) {
+      this.markUpdateReady()
+      return
+    }
+    if (this.downloadPromise) {
+      await this.downloadPromise
+      return
+    }
+    const handle = await this.ensureMonitor()
+    this.startUpdate(handle)
+    if (this.downloadPromise) await this.downloadPromise
+  }
+
+  close () {
+    this.closed = true
+    this.rejectDownload?.(new Error('Updater closed'))
+    this.clearDownloadPromise()
+    const client = this.client
+    this.client = undefined
+    this.monitorHandle = undefined
+    this.monitorPromise = undefined
+    client?.close()
+  }
+
+  install (forceRunAfter = false): boolean {
+    this.close()
+    if (!this.hasUpdate) return false
+    this.hasUpdate = false
+    if (forceRunAfter) {
+      // Release the single-instance lock before spawning the updated version
+      app.releaseSingleInstanceLock()
+      const child = spawn('flatpak-spawn', ['--latest-version', '/app/bin/hayase'], {
+        detached: true,
+        stdio: 'ignore'
+      })
+      child.on('error', (err) => log.error('[FlatpakUpdater] Failed to relaunch latest version:', err))
+      child.unref()
+      app.quit()
+      return true
+    }
+    // The new Flatpak commit is already deployed; normal app.quit() completes the update
+    return false
+  }
+}
